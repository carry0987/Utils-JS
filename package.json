{
  "name": "@carry0987/utils",
  "version": "4.2.0",
  "description": "A library for using common tools and alias methods",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./types": "./dist/types/index.d.ts"
  },
  "sideEffects": false,
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "rolldown -c && pnpm test:types",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.dist.json",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carry0987/Utils-JS.git"
  },
  "keywords": [
    "util",
    "utils"
  ],
  "author": "carry0987",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/carry0987/Utils-JS/issues"
  },
  "homepage": "https://github.com/carry0987/Utils-JS#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.2",
    "happy-dom": "^20.14.5",
    "msw": "^3.0.0",
    "rolldown": "^1.2.11",
    "rolldown-plugin-dts": "^0.28.6",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
