{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "importHelpers": true,
    "strict": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*", "test/**/*", "rolldown.config.ts"],
  "exclude": ["node_modules", "dist", "**/__tests__/**/*"]
}
